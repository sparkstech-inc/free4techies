# ============================================================
# Free4Techies — Environment Variables (optional)
# ============================================================
# This is a PURE STATIC site. There is NO backend and NO server.
# The only env vars are Vite build-time variables (VITE_ prefix)
# that get baked into the frontend bundle.
#
# Set them in your host's project settings (Vercel / Netlify) or
# in a local .env file before `npm run build`. ALL are optional —
# the site has safe defaults.

# ===== Repository coordinates =====
# The GitHub repo that stores public/resources.json and runs the
# auto-merge GitHub Actions. Used by the submit form to build the
# pre-filled issue URL, and by links in the header/footer.
VITE_REPO_OWNER=sparkstech-inc
VITE_REPO_NAME=free4techies

# ===== Sponsor destination =====
# Where the "Sponsor" button links. Defaults to GitHub Sponsors.
# Can be a PayNow payment link, Buy Me a Coffee, Ko-fi, etc.
VITE_SPONSOR_URL=
VITE_SPONSOR_LABEL=

# ===== Ads (optional) =====
# Reserved ad placements render a tasteful placeholder by default.
# Wire up your network inside frontend/src/components/AdSlot.jsx.
VITE_AD_PROVIDER=
VITE_AD_CLIENT=
VITE_AD_SLOT=

# NOTE: GitHub Actions use the built-in GITHUB_TOKEN automatically.
# You do NOT need to set any GitHub secrets for submissions to work.
