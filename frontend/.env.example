# Frontend environment variables (optional — all have safe defaults).
# These are baked into the static build by Vite. Set them BEFORE `npm run build`.
# On Vercel/Netlify, add them in the project's environment-variable settings.

# ===== Repository coordinates =====
# The GitHub repo that stores public/resources.json and runs the Actions.
# Defaults to sparkstech-inc/free4techies. Override if you fork.
VITE_REPO_OWNER=sparkstech-inc
VITE_REPO_NAME=free4techies

# ===== Sponsor destination =====
# Where the "Sponsor" button links. Defaults to GitHub Sponsors for the owner.
# Can be a PayNow payment link, Buy Me a Coffee, Ko-fi, etc.
VITE_SPONSOR_URL=
VITE_SPONSOR_LABEL=

# ===== Ads (optional) =====
# Reserved ad placements render a tasteful placeholder by default.
# Wire up your network inside src/components/AdSlot.jsx to enable.
VITE_AD_PROVIDER=
VITE_AD_CLIENT=
VITE_AD_SLOT=
